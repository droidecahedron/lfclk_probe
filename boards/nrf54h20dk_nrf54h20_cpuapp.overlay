/*
 * Both nodes ship disabled in nrf54h20.dtsi and nothing on this board target
 * claims either one. Enabling them here instead of alongside the probe logic
 * keeps a resource conflict bisectable to this file.
 *
 * cpuapp has no core-local TIMER, RTC or DPPIC at all: nrf54h20_cpuapp.dtsi
 * deletes cpurad_peripherals, and cpuapp_peripherals holds only the local
 * HSFLL, IPCT, two WDTs, resetinfo and the 802.15.4 node. Everything below is
 * therefore in the global domain at peripheral@5f000000.
 */

/*
 * LF side of the measurement. rtc130 counts lfclk directly
 * (nrf54h20.dtsi rtc@928000: clocks = <&lfclk>, clock-frequency = <32768>,
 * prescaler = <1>, cc-num = <4>), which is the whole point: it is the only
 * counter here whose rate is the thing under test.
 */
&rtc130 {
	status = "okay";
};

/*
 * HF side. timer130 is clocked from fll16m with prescaler 0
 * (nrf54h20.dtsi timer@9a2000: clocks = <&fll16m>, prescaler = <0>,
 * cc-num = <6>, max-bit-width = <32>), so the reference is the 16 MHz slow
 * peripheral clock rather than anything DVFS touches.
 *
 * Not timer120 or timer121: those hang off hsfll120, which scales with DVFS,
 * and their IRQs are routed to FLPR by default. Not timer020/021/022 either,
 * those are cpurad-local and deleted from this build.
 */
&timer130 {
	status = "okay";
};

/*
 * timer130's clock parent, needed as a device and not just as a DT phandle so
 * accuracy can be requested on it before the gate. Disabled in nrf54h20.dtsi;
 * zephyr/tests/drivers/clock_control/nrf_clock_control has the same one-liner
 * in its cpuapp overlay.
 */
&fll16m {
	status = "okay";
};

/*
 * Fabric for the hardware-gated variant. rtc130 sits on the 0x5f92_0000 bus
 * (SPU131) and timer130 on 0x5f9a_0000 (SPU134), confirmed by the generated
 * SPU_PERIPH_PERM entries, so an RTC event reaching a TIMER task has to cross a
 * PPIB bridge. dppic130 is the hub and takes no link property of its own; the
 * leaf declares the route and the periphconf generator emits both halves.
 *
 * One sink-channels entry on dppic133 produces, per
 * build/lfclk_probe/zephyr/periphconf_entries_generated.c:
 *   PERIPHCONF_PPIB_SUBSCRIBE_SEND(ppib130, 16, true)   PPIB130 ch. 16 =>
 *   PERIPHCONF_PPIB_PUBLISH_RECEIVE(ppib134, 0, true)   PPIB134 ch. 0
 * which matches offset = <16> on the ppib134 node.
 *
 * Do not give the ppib nodes a status. PPIBs are secure domain owned, and
 * claiming them emits SPU_PERIPH_PERM writes that periphconf-check rejects as
 * UNRECOGNIZED_REGISTER, which stops the device booting.
 *
 * Channels 2 and 3, not 0 and 1: MPSL reserves DPPIC130 channel 0 for itself
 * (MPSL_RESERVED_DPPI_SINK_CHANNELS in nrf/subsys/mpsl/init/mpsl_init.c), and
 * this probe is meant to coexist with a radio application. The first channel is
 * the start boundary, the second the end boundary, read back in C from these
 * properties so the numbers live in one place.
 *
 * The channel index is the same on both sides of the bridge. MPSL relies on the
 * same thing, enabling matching indices on DPPIC130 and DPPIC132 in
 * mpsl_init.c. The secure domain no longer enables local-domain DPPI channels,
 * so the application has to enable both sides itself.
 */
&dppic130 {
	status = "okay";
	owned-channels = <2 3>;
};

&dppic133 {
	status = "okay";
	owned-channels = <2 3>;
	sink-channels = <2 3>;
};
